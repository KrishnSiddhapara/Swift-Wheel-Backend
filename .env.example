# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/swiftwheel

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Cashfree Payments (Dashboard → Developers → API Keys)
# App ID / Secret Key from Cashfree merchant dashboard
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Use "production" only with live keys; otherwise sandbox is used
# CASHFREE_ENV=production

# Where users return after payment (no trailing slash)
FRONTEND_URL=http://localhost:5173

PORT=5000
